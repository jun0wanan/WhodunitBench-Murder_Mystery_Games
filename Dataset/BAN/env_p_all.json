{"key_clues_pool": {"A\u540c\u4e8b": ["18:15\u540c\u4e8bA\u6700\u7ec8\u627e\u5230\u4e86\u6709\u95ee\u9898\u7684\u5408\u540c\u3002\u4f60A\u540c\u4e8b\u76d8\u7b97\u7740\u5982\u4f55\u7528\u8fd9\u4e00\u4e2a\u8bc1\u636e\u9006\u8f6c\u4f60\u4eec\u4e24\u4eba\u7684\u5730\u4f4d\uff0c\u56de\u529e\u516c\u5ba4\u7684\u9014\u4e2d\u57282\u697c\u9047\u5230\u524d\u53bb\u5f00\u4f1a\u7684\u7ecf\u7406\u3002"], "B\u5973\u58eb": ["19:10\uff0cB\u5973\u58eb\u4f60\u7b49\u5f97\u4e0d\u8010\u70e6\u4e86\uff0c\u6c14\u547c\u547c\u5730\u51b2\u8fdb\u674e\u65e0\u4e49\u7684\u529e\u516c\u5ba4\uff0c\u53d1\u73b0\u674e\u65e0\u4e49\u5df2\u7ecf\u6b7b\u4e86\uff0c\u8eba\u5728\u5730\u4e0a\u7684\u8840\u6cca\u5f53\u4e2d\uff0c\u4f46\u5f88\u5feb\u4f60B\u5973\u58eb\u8003\u8651\u5230\u5982\u679c\u88ab\u8b66\u65b9\u53d1\u73b0\u4f60\u4eec\u4e4b\u95f4\u5b58\u5728\u7740\u60c5\u611f\u77db\u76fe\u548c\u5371\u673a\u7684\u8bdd\uff0c\u4f60\u65e0\u7591\u6709\u5f88\u5927\u7684\u5acc\u7591\uff0c\u6240\u4ee5\u4f60\u5fc5\u987b\u9690\u7792\u4f60\u4e0e   \u7ecf\u7406\u7684\u5173\u7cfb\u4ee5\u53ca\u4f60\u4e0e\u4e08\u592b\u7684\u611f\u60c5\u5371\u673a"], "C\u7ecf\u7406": ["17:00C\u7ecf\u7406\u4f60\u56de\u5230\u516c\u53f8\uff0c\u9047\u5230\u4e86C\u7ecf\u7406\u4f60\u7684\u5927\u5b66\u540c\u5b66\uff0c\u540c\u65f6\u4e5f\u662f\u4f60\u7684\u60c5\u4eba\u7684   \u5973\u58eb\uff0cC\u7ecf\u7406\u4f60\u53d1\u73b0\u5979\u8138\u4e0a\u6709\u7600\u4f24\uff0cC\u7ecf\u7406\u4f60\u5173\u5207\u5730\u8be2\u95ee\u53d7\u4f24\u7684\u7f18\u7531\u3002"]}, "role-q": {}, "public_clue": "\n", "key_clues_questions": [{"q": "\u5728\u4ec0\u4e48\u65f6\u95f4\u540c\u4e8bA\u627e\u5230\u4e86\u6709\u95ee\u9898\u7684\u5408\u540c\uff1fa. 16:15 b. 17:00 c. 18:15 d. 19:10", "ans": "c", "source": "p-1"}, {"q": "\u540c\u4e8bA\u5728\u54ea\u4e2a\u5730\u70b9\u9047\u5230\u4e86\u524d\u53bb\u5f00\u4f1a\u7684\u7ecf\u7406\uff1fa. 1\u697c b. 2\u697c c. 3\u697c d. \u529e\u516c\u5ba4", "ans": "b", "source": "p-1"}, {"q": "B\u5973\u58eb\u51b2\u8fdb\u674e\u65e0\u4e49\u7684\u529e\u516c\u5ba4\u662f\u5728\u4ec0\u4e48\u65f6\u95f4\uff1fa. 16:15 b. 17:00 c. 18:15 d. 19:10", "ans": "d", "source": "p-1"}, {"q": "\u674e\u65e0\u4e49\u88ab\u53d1\u73b0\u7684\u72b6\u6001\u662f\u4ec0\u4e48\uff1fa. \u6b63\u5728\u6253\u7535\u8bdd b. \u559d\u5496\u5561 c. \u8eba\u5728\u8840\u6cca\u4e2d\u5df2\u6b7b d. \u6b63\u5728\u5de5\u4f5c", "ans": "c", "source": "p-1"}, {"q": "B\u5973\u58eb\u4e3a\u4f55\u9700\u8981\u9690\u7792\u5979\u4e0e\u7ecf\u7406\u7684\u5173\u7cfb\uff1fa. \u907f\u514d\u5347\u804c\u4e89\u8bae b. \u9632\u6b62\u5f15\u8d77\u8b66\u65b9\u6000\u7591 c. \u4fdd\u6301\u804c\u573a\u5f62\u8c61 d. \u907f\u514d\u540c\u4e8b\u7684\u6d41\u8a00", "ans": "b", "source": "p-1"}, {"q": "C\u7ecf\u7406\u5728\u4ec0\u4e48\u65f6\u95f4\u56de\u5230\u516c\u53f8\uff1fa. 16:15 b. 17:00 c. 18:15 d. 19:10", "ans": "b", "source": "p-1"}, {"q": "C\u7ecf\u7406\u9047\u5230\u7684\u4eba\u662f\u8c01\uff1fa. \u4ed6\u7684\u5927\u5b66\u540c\u5b66 b. \u4ed6\u7684\u60c5\u4eba c. \u4ed6\u7684\u60c5\u4eba\u517c\u5927\u5b66\u540c\u5b66 d. \u4ed6\u7684\u524d\u4efb", "ans": "c", "source": "p-1"}, {"q": "C\u7ecf\u7406\u6ce8\u610f\u5230\u5973\u58eb\u8138\u4e0a\u6709\u4ec0\u4e48\u5f02\u5e38\uff1fa. \u7600\u4f24 b. \u7b11\u5bb9 c. \u6c57\u6c34 d. \u5316\u5986\u8fc7\u5ea6", "ans": "a", "source": "p-1"}, {"q": "B\u5973\u58eb\u548cC\u7ecf\u7406\u7684\u5173\u7cfb\u662f\u4ec0\u4e48\uff1fa. \u540c\u4e8b b. \u60c5\u4eba c. \u5144\u59b9 d. \u7ade\u4e89\u5bf9\u624b", "ans": "b", "source": "p-1"}, {"q": "\u53d1\u73b0\u674e\u65e0\u4e49\u5df2\u7ecf\u6b7b\u4ea1\u7684B\u5973\u58eb\u6700\u62c5\u5fc3\u4ec0\u4e48\uff1fa. \u4f1a\u8fdf\u5230 b. \u88ab\u8ba4\u4e3a\u662f\u5acc\u7591\u4eba c. \u6ca1\u6709\u5b8c\u6210\u5de5\u4f5c d. \u5f71\u54cd\u664b\u5347", "ans": "b", "source": "p-1"}], "role": [{"name": "A\u540c\u4e8b", "back": "\n17:00\u4f60\u51fa\u5916\u529e\u4e8b\uff1b\n17:40\u4f60\u56de\u5230\u529e\u516c\u5ba4\uff0c\u53d1\u73b0\u674e\u65e0\u4e49\u9760\u5728\u529e\u516c\u6905\u4e0a\u7761\u7740\u4e86\uff0c\u4f60\u6ca1\u53bb\u53eb\u9192\u4ed6\uff0c\u800c\u662f\u8fdb\u536b\u751f\u95f4\u62bd\u4e86\u4e00\u4f1a\u70df\u3002\n18:00\u4f60\u5728\u5395\u6240\u51fa\u6765\u540e\u770b\u5230  \u4ee3\u7406\u5728\u529e\u516c\u5ba4\u95e8\u53e3\u5f98\u5f8a\uff0c\u624b\u4e0a\u62ff\u7740\u4e00\u4e2a\u6587\u4ef6\u888b\uff0c\u4f60\u5bb3\u6015\u8eab\u4e0a\u7684\u70df\u5473\u88ab\u6b7b\u8005\u95fb\u5230\u800c\u88ab\u9a82\uff0c\u4e8e\u662f\u52301\u697c\u66f4\u8863\u5ba4\u6362\u4e86\u4e00\u4ef6\u8863\u670d\uff1b\n19:20\u4f60\u66f4\u6362\u8863\u670d\u540e\u5230\u516c\u53f8\u98df\u5802\u7528\u9910\uff0c\u4e8e:19:40\u63a5\u5230\u4f20\u5524\u3002\n\u6848\u53d1\u524d\u4f60\u638c\u63e1\u7684\u4fe1\u606f\n1\u3001\u6240\u5728\u7684\u516c\u53f8\u5f88\u6ce8\u91cd\u5458\u5de5\u4e2a\u4eba\u7684\u9053\u5fb7\u884c\u4e3a\uff0c\u53cd\u5bf9\u4efb\u4f55\u5f62\u5f0f\u7684\u529e\u516c\u5ba4\u604b\u7231\uff0c\u5728\u516c\u53f8\u91cc\u5de5\u4f5c\u7684\u5458\u5de5\u5176\u5b9e\u90fd\u5f88\u538b\u6291\uff0c\u4e0d\u8fc7\u8fd9\u4e2a\u516c\u53f8\u7684\u85aa\u8d44\u6bd4\u8f83\u9ad8\uff0c\u6240\u4ee5\u5927\u5bb6\u4e5f\u6ca1\u89c9\u5f97\u6709\u4ec0\u4e48\u3002\n2\u3001\u4f60\u542c\u5230\u8fc7  \u4ee3\u7406\u66fe\u7ecf\u5411\u6b7b\u8005\u884c\u8d3f\u7684\u4f20\u8a00\uff1b\n3\u3001\u4f60\u4e8e\u5f53\u592917:10\u5728\u516c\u53f82\u697c\u6863\u6848\u5ba4\u770b\u5230  \u5973\u58eb\u4e0e  \u7ecf\u7406\u5728\u4f4e\u58f0\u8ba8\u8bba\u7740\u4ec0\u4e48\uff0c\u4f46\u662f\u4f60\u79bb\u5f97\u592a\u8fdc\u4e86\uff0c\u542c\u4e0d\u5230\u5728\u8bf4\u4e9b\u4ec0\u4e48\uff1b\n4\u3001\u6b7b\u8005\u662f\u4e2a\u5f88\u56a3\u5f20\u7684\u4eba\uff0c\u8fde\u4e0a\u7ea7\u4e5f\u4e0d\u653e\u5728\u773c\u91cc\uff0c\u7ecf\u5e38\u5f53\u4f17\u9a73\u65a5  \u7ecf\u7406\u3001  \u4ee3\u7406\u548c\u4f60\u3002\n5\u3001\u4e09\u4e2a\u6708\u524d\uff0c\u9500\u552e\u90e8\u7684\u4e00\u4f4d\u7ecf\u7406\u548c\u4ed6\u90e8\u95e8\u7684\u4e00\u4f4d\u540c\u4e8b\u8c08\u604b\u7231\u88ab\u53d1\u73b0\u540e\u88ab\u516c\u53f8\u53cc\u53cc\u8f9e\u9000\u3002\n6\u3001\u6700\u8fd1\u516c\u53f8\u6b63\u5728\u641e\u4f9b\u5e94\u5546\u4f9b\u9500\u5408\u540c\u6e05\u7406\u3001\u6574\u7406\u5de5\u4f5c\uff0c\u76ee\u7684\u662f\u5c06\u8d39\u7528\u8fc7\u9ad8\u3001\u865a\u62a5\u4ef7\u683c\u7684\u4f9b\u5e94\u5546\u6392\u9664\u6389\uff0c\u4fdd\u8bc1\u914d\u4ef6\u4ef7\u683c\u5e73\u7a33\u3002\n7\u3001\u529e\u516c\u5ba4\u7684\u95e8\u94a5\u5319\u53ea\u6709\u6b7b\u8005\u624d\u6709\u3002\n\u6848\u53d1\u65f6\u95f4\u4f60\u771f\u6b63\u5728\u505a\u7684\u4e8b\uff1a\n17:00-17:40\u4f60\u5e76\u6ca1\u6709\u51fa\u5916\u529e\u4e8b\uff0c\u4f60\u8eb2\u57282\u697c\u6863\u6848\u5ba4\u770b\u7ffb\u770b\u4ee5\u524d\u7684\u8d44\u6599\uff0c\u4f60\u542c\u5230\u4e86\u6b7b\u8005\u6536\u53d7\u8d3f\u8d42\u7684\u884c\u4e3a\uff0c\u4f60\u5728\u7ffb\u770b\u6b64\u524d\u7684\u5408\u540c\u6863\u6848\uff0c\u5e0c\u671b\u627e\u5230\u4ed6\u72af\u7f6a\u7684\u8bc1\u636e\uff1b\n17:40\u7684\u65f6\u5019\uff0c\u4f60\u56de\u5230\u529e\u516c\u5ba4\u62ff\u8d44\u6599\u5c31\u9a6c\u4e0a\u79bb\u5f00\u4e86\uff0c\u90a3\u65f6\u5019\u4ed6\u770b\u4e0a\u53bb\u50cf\u662f\u7761\u7740\u4e86\u3002\n18:00\u7684\u65f6\u5019\uff0c\u4f60\u4e3a\u4e86\u786e\u5b9a\u5408\u540c\u5e8f\u53f7\u518d\u4e00\u6b21\u56de\u5230\u529e\u516c\u5ba4\uff0c\u4f46\u4f60\u770b\u5230  \u4ee3\u7406\u6765\u4e86\uff0c\u4f60\u6709\u4e9b\u5fc3\u865a\u5730\u907f\u5f00\u4e86\uff0c\u56de\u5230\u4e86\u6863\u6848\u5ba4\u3002\n18:15\u4f60\u6700\u7ec8\u627e\u5230\u4e86\u6709\u95ee\u9898\u7684\u5408\u540c\u3002\u4f60\u76d8\u7b97\u7740\u5982\u4f55\u7528\u8fd9\u4e00\u4e2a\u8bc1\u636e\u9006\u8f6c\u4f60\u4eec\u4e24\u4eba\u7684\u5730\u4f4d\uff0c\u56de\u529e\u516c\u5ba4\u7684\u9014\u4e2d\u57282\u697c\u9047\u5230\u524d\u53bb\u5f00\u4f1a\u7684  \u7ecf\u7406\u3002\n18:25\u4f60\u62ff\u7740\u6709\u95ee\u9898\u7684\u5408\u540c\u56de\u5230\u4e86\u529e\u516c\u5ba4\uff0c\u8fd9\u65f6\u5019\u4f60\u53d1\u73b0\u529e\u516c\u5ba4\u91cc\u7684\u674e\u65e0\u4e49\u9760\u5728\u6905\u5b50\u4e0a\u5df2\u7ecf\u6b7b\u4e8e\u975e\u547d\uff0c\u8116\u5b50\u91cc\u55b7\u51fa\u7684\u8840\u6d41\u4e86\u4e00\u5730\uff0c\u4f60\u614c\u5fd9\u4e4b\u4e2d\uff0c\u638f\u51fa\u7535\u8bdd\u8981\u62a5\u8b66\uff0c\u4f46\u662f\uff0c\u8fd9\u4e2a\u65f6\u5019\uff0c\u4f60\u6ce8\u610f\u5230\u6b7b\u8005\u53f3\u624b\u7684\u98df\u6307\u642d\u5728\u684c\u4e0a\uff0c\u4f3c\u4e4e\u6709\u4ec0\u4e48\u5b57\uff0c\u4f60\u51d1\u8fc7\u53bb\u4e00\u770b\uff0c\u4f60\u5413\u4e86\u4e00\u8df3\uff0c\u4e0a\u9762\u8d6b\u7136\u5199\u7740\u4f60\u7684\u540d\u5b57\uff0c\u4f60\u9a6c\u4e0a\u660e\u767d\uff0c\u8fd9\u662f\u5ac1\u7978\uff1b\n18:30\u4f60\u9a6c\u4e0a\u7528\u62b9\u5e03\u5f00\u59cb\u64e6\u53bb\u684c\u5b50\u4e0a\u7684\u5b57\uff0c\uff0c\u4f46\u662f\u7531\u4e8e\u62b9\u5e03\u662f\u5e72\u7684\uff0c\u6548\u679c\u5e76\u4e0d\u7406\u60f3\uff0c\u5982\u679c\u4ed4\u7ec6\u770b\uff0c\u8fd8\u7a0d\u5fae\u80fd\u770b\u5f97\u51fa\u4e00\u4e9b\u5b57\u8ff9\uff0c\u6ca1\u6709\u529e\u6cd5\uff0c\u73b0\u5728\u662f\u4e0b\u73ed\u65f6\u95f4\uff0c\u529e\u516c\u697c\u6ca1\u6709\u4ec0\u4e48\u4eba\u8fdb\u51fa\uff0c\u4e8e\u662f\u4f60\u6025\u5fd9\u5230\u4e8c\u697c\u536b\u751f\u95f4\u6d78\u6e7f\u4e86\u6bdb\u5dfe\u518d\u56de\u6765\u64e6\uff1b \n18:40\u4f60\u4ece2\u697c\u536b\u751f\u95f4\u56de\u5230\u6848\u53d1\u5730\u70b9\u529e\u516c\u5ba4\uff0c\u4f60\u628a\u684c\u5b50\u4e0a\u7684\u8840\u5b57\u64e6\u53bb\u540e\uff0c\u4f60\u89c9\u5f97\u8fd8\u662f\u4e0d\u653e\u5fc3\uff0c\u6b63\u597d\uff0c\u4f60\u6ce8\u610f\u5230\u4e86\u529e\u516c\u5ba4\u5730\u677f\u6709\u4e9b\u51cc\u4e71\uff0c\u6587\u4ef6\u3001\u7167\u7247\u4ec0\u4e48\u7684\u4e22\u4e86\u4e00\u5730\uff0c\u4e8e\u662f\u4f60\u628a\u6b7b\u8005\u4ece\u6905\u5b50\u4e0a\u62fd\u4e86\u4e0b\u6765\uff0c\u4f2a\u88c5\u6210\u8d77\u4e89\u6267\u540e\u88ab\u4eba\u6253\u5012\u7684\u6837\u5b50\uff0c\u4f7f\u4eba\u4e0d\u6ce8\u610f\u5230\u684c\u5b50\u4e0a\u7684\u75d5\u8ff9\uff0c\u4f46\u662f\uff0c\u4f60\u53d1\u73b0\u4f60\u8f9b\u82e6\u627e\u5230\u7684\u6b7b\u8005\u6536\u53d7\u8d3f\u8d42\u7684\u8bc1\u636e-\u8d2d\u8fdb\u5408\u540c\u4e0d\u89c1\u4e86\u3002\n19:00\u4f60\u6ca1\u6709\u518d\u53bb\u5bfb\u627e\u90a3\u4efd\u5408\u540c\uff0c\u4f60\u6025\u5fd9\u53bb1\u697c\u66f4\u6362\u4e86\u8863\u670d\uff0c\u88c5\u4f5c\u82e5\u65e0\u5176\u4e8b\u7684\u6837\u5b50\u5f80\u98df\u5802\u8d70\u53bb\uff0c\u5e76\u5728\u98df\u5802\u5403\u8d77\u4e86\u665a\u9910\u3002\n\u4f60\u4e0e\u6b7b\u8005\u7684\u5173\u7cfb\n1\u3001\u4f60\u4e0e\u6b7b\u8005\u540c\u4e8b\u4e4b\u95f4\u7684\u5173\u7cfb\u5e76\u4e0d\u5e73\u7b49\uff0c\u6b7b\u8005\u7ecf\u5e38\u51ed\u501f\u81ea\u5df1\u7684\u8d44\u5386\u6765\u6253\u538b\u4f60\uff0c\u6240\u4ee5\u4f60\u5f88\u53cd\u611f\u4ed6\uff0c\u751a\u81f3\u5230\u4e86\u4f60\u6839\u672c\u4e0d\u613f\u610f\u5728\u4e00\u4e2a\u529e\u516c\u5ba4\u4e00\u8d77\u5f85\u7740\u7684\u5730\u6b65\uff1b\n2\u3001\u4e0a\u5468\u6b7b\u8005\u4e0a\u7ea7\u60f3\u8981\u63d0\u62d4\u4f60\u5230\u53e6\u4e00\u4e2a\u90e8\u95e8\u62c5\u4efb\u57fa\u5c42\u7ba1\u7406\uff0c\u4f46\u662f\u88ab\u6b7b\u8005\u9a73\u56de\u3002\u4e8e\u662f\u4f60\u5bf9\u6b7b\u8005\u5fc3\u6000\u6028\u6068\u3002\n", "r_q": [{"q": "\u4f60\u572817:40\u56de\u5230\u529e\u516c\u5ba4\u65f6\u53d1\u73b0\u4e86\u4ec0\u4e48\u60c5\u51b5\uff1fa. \u674e\u65e0\u4e49\u6b63\u5728\u5de5\u4f5c b. \u674e\u65e0\u4e49\u5728\u529e\u516c\u6905\u4e0a\u7761\u7740\u4e86 c. \u674e\u65e0\u4e49\u4e0d\u5728\u529e\u516c\u5ba4 d. \u674e\u65e0\u4e49\u6b63\u5728\u6253\u7535\u8bdd", "ans": "b"}], "m": 0, "q": ["\u4f60\u572817:40\u56de\u5230\u529e\u516c\u5ba4\u65f6\u53d1\u73b0\u4e86\u4ec0\u4e48\u60c5\u51b5\uff1fa. \u674e\u65e0\u4e49\u6b63\u5728\u5de5\u4f5c b. \u674e\u65e0\u4e49\u5728\u529e\u516c\u6905\u4e0a\u7761\u7740\u4e86 c. \u674e\u65e0\u4e49\u4e0d\u5728\u529e\u516c\u5ba4 d. \u674e\u65e0\u4e49\u6b63\u5728\u6253\u7535\u8bdd"], "a": ["b"]}, {"name": "B\u5973\u58eb", "back": " \n17:00\u4f60\u7ea6\u597d\u674e\u65e0\u4e49\u5728\u4eca\u665a18:00\u4e00\u8d77\u5403\u4e2a\u665a\u996d\uff0c\u4e8e\u662f\u4f60\u4ece17:00\u5c31\u5230\u516c\u53f8\u697c\u4e0b\u7b49\u5f85\u6b7b\u8005\uff0c\u671f\u95f4\u770b\u5230   \u7ecf\u7406\u5f00\u8f66\u56de\u6765\uff1b\n17:50\u4f60\u7b49\u4e86\u5f88\u4e45\uff0c\u674e\u65e0\u4e49\u90fd\u6ca1\u6709\u4e0b\u6765\uff0c\u4e8e\u662f\u4f60\u7ed9\u4ed6\u6253\u4e86\u7535\u8bdd\uff0c\u4f46\u662f\u88ab\u5bf9\u65b9\u6302\u65ad\u4e86\uff0c\u8fc7\u4e86\u4e0d\u4e45\uff0c\u4f60\u6536\u5230\u674e\u65e0\u4e49\u7684\u77ed\u4fe1\uff1a\u201c\u4eca\u665a\u8981\u5f00\u4f1a\uff0c\u8981\u8fdf\u4e00\u4e9b\u624d\u80fd\u4e0b\u53bb\uff0c\u8981\u4f60\u5728\u697c\u4e0b\u7b49\u4e00\u4e0b\uff0c\u9884\u8ba1\u898119:00\u624d\u80fd\u79bb\u5f00\u3002\u201d\n19:20\u4f60\u7b49\u5230\u5f88\u4e45\u8fd8\u6ca1\u6709\u63a5\u5230\u674e\u65e0\u4e49\u7684\u7535\u8bdd\uff0c\u4f60\u6253\u4e86\u7535\u8bdd\u8fc7\u53bb\uff0c\u4f46\u6ca1\u6709\u56de\u5e94\uff0c\u4e8e\u662f\u4f60\u53bb\u4e86\u529e\u516c\u5ba4\uff0c\u4e4b\u540e\u53d1\u73b0\u5c38\u4f53\uff0c\u5e76\u62a5\u8b66\u3002\n\u6848\u53d1\u524d\u4f60\u638c\u63e1\u7684\u4fe1\u606f\n1\u3001\u4e08\u592b\u7684\u516c\u53f8\u5f88\u6ce8\u91cd\u5458\u5de5\u4e2a\u4eba\u7684\u9053\u5fb7\u884c\u4e3a\uff0c\u53cd\u5bf9\u4efb\u4f55\u5f62\u5f0f\u7684\u529e\u516c\u5ba4\u604b\u7231\uff0c\u5728\u516c\u53f8\u91cc\u5de5\u4f5c\u7684\u5458\u5de5\u5176\u5b9e\u90fd\u5f88\u538b\u6291\uff0c\u4e0d\u8fc7\u8fd9\u4e2a\u516c\u53f8\u7684\u85aa\u8d44\u6bd4\u8f83\u9ad8\uff0c\u6240\u4ee5\u5927\u5bb6\u4e5f\u6ca1\u89c9\u5f97\u6709\u4ec0\u4e48\u3002\n2\u3001\u6b7b\u8005\u5411\u4f60\u5439\u5618\u4ed6\u66fe\u7ecf\u5982\u4f55\u6536\u53d6CN\u516c\u53f8\u4ee3\u7406\u5546\u7684\u8d3f\u8d42\uff0c\u5982\u4f55\u5c06   \u540c\u4e8b\u7684\u664b\u5347\u5426\u51b3\u3001\u538b\u5f97\u540c\u4e8b\u4e0d\u80fd\u7ffb\u8eab\uff1b\n3\u300117:50\uff0c\u4f60\u770b\u5230    \u4ee3\u7406\u6025\u5306\u5306\u5730\u5954\u4e0a\u529e\u516c\u697c\u3002\n4\u300119:00\uff0c\u4f60\u770b\u5230    \u4ee3\u7406\u795e\u8272\u5306\u5fd9\u5730\u4ece\u697c\u4e0a\u4e0b\u6765\uff0c\n5\u3001\u4f60\u4e0e\u674e\u65e0\u4e49\u53ca   \u7ecf\u7406\u662f\u5927\u5b66\u540c\u5b66\u5173\u7cfb\uff0c\u4f60\u66fe\u7ecf\u662f\u4e24\u4eba\u5171\u540c\u8ffd\u6c42\u7684\u5bf9\u8c61\u3002\n5\u3001\u6628\u665a\u4f60\u56e0\u4e3a\u4e0e   \u7ecf\u7406\u7684\u4e8b\u88ab\u53d1\u73b0\uff0c\u800c\u906d\u5230\u4e86\u6b7b\u8005\u7684\u6bb4\u6253\u3002\n\u6848\u53d1\u65f6\u95f4\u4f60\u771f\u6b63\u5728\u505a\u7684\u4e8b\uff1a\n16:50\u4f60\u4e0e   \u7ecf\u7406\u5077\u60c5\u7684\u4e8b\u5b9e\u88ab\u674e\u65e0\u4e49\u53d1\u73b0\u4e86\uff0c\u674e\u65e0\u4e49\u5c06\u4f60\u6253\u4e86\u4e00\u987f\uff0c\u4f46\u662f\u4f60\u5e0c\u671b\u80fd\u633d\u56de\u8fd9\u6bb5\u611f\u60c5\uff0c\u4e8e\u662f\u4f60\u5e0c\u671b\u548c\u674e\u65e0\u4e49\u5750\u4e0b\u6765\u597d\u597d\u8c08\u8c08\uff0c\u4f60\u5df2\u7ecf\u505a\u597d\u4e86\u4e0e   \u7ecf\u7406\u65ad\u7edd\u6765\u5f80\u7684\u51b3\u5fc3\u3002\u7126\u6025\u7684\u4f60\u63d0\u524d\u4e86\u4e00\u4e2a\u591a\u5c0f\u65f6\u5230\u4e86SB\u516c\u53f8\u697c\u4e0b\u3002\n17:10\u4f60\u9047\u5230   \u7ecf\u7406\uff0c\u4f60\u7684\u60c5\u4eba\uff0c\u4ed6\u53d1\u73b0\u4e86\u4f60\u7684\u4f24\u75d5\uff0c\u5c06\u4f60\u5e26\u5230\u6863\u6848\u5ba4\uff0c\u4e3a\u4f60\u7684\u4f24\u53e3\u505a\u4e86\u7b80\u5355\u5904\u7406\uff0c\u4f60\u544a\u8bc9\u4ed6\u5077\u60c5\u88ab\u53d1\u73b0\u7684\u4e8b\u4ee5\u53ca\u4e0e\u4ed6\u548c\u5e73\u5206\u624b\uff0c\u4e0d\u518d\u5f80\u6765\u7684\u51b3\u5b9a\u3002\u4ed6\u4e5f\u7b54\u5e94\u4e86\uff0c\u4f60\u4eec\u5f85\u5230\u4e8617:20\uff0c\u4f60\u62c5\u5fc3\u674e\u65e0\u4e49\u4f1a\u8054\u7cfb\u4f60\uff0c\u4e8e\u662f\u4e0e   \u7ecf\u7406\u544a\u522b\uff0c\u56de\u5230\u4e86\u697c\u4e0b\uff0c\u7ee7\u7eed\u7b49\u5f85\uff1b\n19:10\uff0c\u4f60\u7b49\u5f97\u4e0d\u8010\u70e6\u4e86\uff0c\u6c14\u547c\u547c\u5730\u51b2\u8fdb\u674e\u65e0\u4e49\u7684\u529e\u516c\u5ba4\uff0c\u53d1\u73b0\u674e\u65e0\u4e49\u5df2\u7ecf\u6b7b\u4e86\uff0c\u8eba\u5728\u5730\u4e0a\u7684\u8840\u6cca\u5f53\u4e2d\uff0c\u4f46\u5f88\u5feb\u4f60\u8003\u8651\u5230\u5982\u679c\u88ab\u8b66\u65b9\u53d1\u73b0\u4f60\u4eec\u4e4b\u95f4\u5b58\u5728\u7740\u60c5\u611f\u77db\u76fe\u548c\u5371\u673a\u7684\u8bdd\uff0c\u4f60\u65e0\u7591\u6709\u5f88\u5927\u7684\u5acc\u7591\uff0c\u6240\u4ee5\u4f60\u5fc5\u987b\u9690\u7792\u4f60\u4e0e   \u7ecf\u7406\u768